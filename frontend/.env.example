# ---------------------------------------------------------------------------
# Vortiqen website — example configuration. No secrets belong in this file;
# anything prefixed VITE_ is inlined into the client bundle and is PUBLIC.
# Copy to .env for local work:  cp .env.example .env
# ---------------------------------------------------------------------------

# Base URL of the Vortiqen API.
#   local:      http://localhost:8000
#   production: https://api.vortiqen.com
# Leave empty to call the API same-origin (for deployments that serve the API
# under the same domain as the site, e.g. behind one reverse proxy).
# If unset entirely, the client falls back to http://localhost:8000 in dev.
VITE_API_BASE_URL="http://localhost:8000"
